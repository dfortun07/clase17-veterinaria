@page
@model clase17david.Pages.MascotasModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Registro de Mascota</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success py-2" role="alert">
                        @Model.Mensaje
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Mascota.PropietarioId" class="form-label"></label>
                        <select asp-for="Mascota.PropietarioId" class="form-select">
                            <option value="">-- Seleccionar Propietario --</option>
                            @foreach (var prop in Model.ListaPropietarios)
                            {
                                <option value="@prop.Id">@prop.NombreCompleto</option>
                            }
                        </select>
                        <span asp-validation-for="Mascota.PropietarioId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mascota.Nombre" class="form-label"></label>
                        <input asp-for="Mascota.Nombre" class="form-control" placeholder="Nombre de la mascota" />
                        <span asp-validation-for="Mascota.Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mascota.Especie" class="form-label"></label>
                        <select asp-for="Mascota.Especie" class="form-select">
                            <option value="Perro">Perro</option>
                            <option value="Gato">Gato</option>
                            <option value="Ave">Ave</option>
                            <option value="Conejo">Conejo</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <span asp-validation-for="Mascota.Especie" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mascota.Raza" class="form-label"></label>
                        <input asp-for="Mascota.Raza" class="form-control" placeholder="Raza" />
                        <span asp-validation-for="Mascota.Raza" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mascota.FechaNacimiento" class="form-label"></label>
                        <input asp-for="Mascota.FechaNacimiento" type="date" class="form-control" />
                        <span asp-validation-for="Mascota.FechaNacimiento" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mascota.Estado" class="form-label"></label>
                        <select asp-for="Mascota.Estado" class="form-select">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                        <span asp-validation-for="Mascota.Estado" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-secondary">Limpiar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Lista de Mascotas</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Mascota</th>
                                <th>Especie / Raza</th>
                                <th>Propietario</th>
                                <th>F. Nacimiento</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListaMascotas.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">
                                        No hay mascotas registradas.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var m in Model.ListaMascotas)
                                {
                                    <tr>
                                        <td>@m.Id</td>
                                        <td><strong>@m.Nombre</strong></td>
                                        <td>@m.Especie (@(string.IsNullOrEmpty(m.Raza) ? "Mestizo" : m.Raza))</td>
                                        <td>@(m.Propietario != null ? m.Propietario.NombreCompleto : "Sin asignar")</td>
                                        <td>@m.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge @(m.Estado == "Activo" ? "bg-success" : "bg-danger")">
                                                @m.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
